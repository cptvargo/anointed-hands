rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'jvonne8@gmail.com';
    }

    // Products: anyone can view the shop, only the admin can add/edit/remove items.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings (contact email, featured piece, etc.): public read, admin write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Custom orders: any visitor can submit one, only the admin can view/manage them.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
